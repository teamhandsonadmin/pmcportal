generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  senior_site_engineer
  site_engineer
  client
}

enum UserStatus {
  active
  invited
  disabled
}

enum TaskStatus {
  draft
  ready
  in_progress
  on_hold
  blocked
  completed
}

// FS/SS/FF/SF, matching the four standard PM dependency types (Zoho, MS
// Project, etc.). FS is the only type that has ever existed in this app —
// every existing TaskDependency row keeps behaving exactly as it always has
// via the field default below.
enum DependencyType {
  FS
  SS
  FF
  SF
}

enum DependencyCategory {
  architect
  client
  consultant
  contractor
  inspector
  procurement
}

enum CompletionStatus {
  YES
  NO
  ON_HOLD
  PENDING
  REVISIONS
  PROCEED
}

// NOTE: the two enums below use UPPER_CASE members, diverging from the
// lowercase_snake_case convention used by every other enum in this file.
// Kept as originally specified by the client, not a mistake to "fix" silently.
enum InventoryUnit {
  PCS
  KG
  TON
  BAG
  LITRE
  SQFT
  CUBIC_M
  BOX
  ROLL
  OTHER
}

enum InventoryTransactionType {
  IN
  OUT
  ADJUSTMENT
}

model UserProfile {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String     @unique
  fullName  String     @map("full_name")
  role      UserRole   @default(site_engineer)
  status    UserStatus @default(invited)
  phone     String?
  isActive  Boolean    @default(true) @map("is_active")
  lastLogin DateTime?  @map("last_login")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  // A `client`-role user is scoped to exactly one project — every draft-
  // sequence server action checks this against the draft/node/edge being
  // touched rather than trusting a client-supplied project id.
  clientProjectId String?  @map("client_project_id") @db.Uuid
  clientProject   Project? @relation(fields: [clientProjectId], references: [id], onDelete: SetNull)

  // Expo push token for the mobile app (site-engineer-app) — written by the
  // app itself via Supabase (RLS-scoped to the caller's own row, see
  // supabase/schema.sql), never by admin-web. Nullable: absent means either
  // never registered or permission was denied: both are valid, silent states,
  // not errors. Overwritten wholesale on every fresh registration rather than
  // versioned/multi-device, since one account maps to one phone in practice
  // today.
  expoPushToken String? @map("expo_push_token")

  // Single-device login lock for the mobile app — set to the device's
  // self-generated, reinstall-resetting identifier on that account's first
  // successful login, and only ever written by the device-locked-login
  // Edge Function's service-role client (never directly writable via the
  // app's own anon-key session — no UPDATE grant exists on these two
  // columns for `authenticated`, unlike expoPushToken above). Null means
  // "never logged in yet" or "reset by an admin," both valid states in
  // which the next successful login establishes a fresh lock.
  lockedDeviceId           String?   @map("locked_device_id")
  lockedDeviceRegisteredAt DateTime? @map("locked_device_registered_at")

  // Remote force-logout for the mobile app — null means no forced logout is
  // pending; a timestamp means "any session that started before this
  // moment must end immediately." Deliberately independent of
  // lockedDeviceId: this ends an active session, it does not change which
  // device the account is allowed to log back in from (that's still only
  // ever changed by the separate device-lock reset action) — a stolen
  // phone needs both actions, someone legitimately switching phones needs
  // only the reset.
  forceLogoutAt DateTime? @map("force_logout_at")

  comments Comment[]

  @@map("user_profiles")
}

model Project {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(200)
  address   String?  @db.VarChar(500)
  area      String?  @db.VarChar(50)
  budget    String?  @db.VarChar(100)
  photoUrl  String?  @map("photo_url")
  siteLatitude  Decimal? @map("site_latitude") @db.Decimal(10, 7)
  siteLongitude Decimal? @map("site_longitude") @db.Decimal(10, 7)
  // Geofence radius for mobile attendance check-in/out distance validation.
  // Null means "not configured" — the mobile app falls back to its own
  // hardcoded default rather than treating null as a zero-radius site.
  siteRadiusMeters Int? @map("site_radius_meters")
  // Project-wide SFT target — distinct from any individual HvacTask.totalSft
  // (a per-task target). Used by lib/data/sft.ts's getProjectSftProgress()
  // as the denominator for the project-level "X of Y sqft done" rollup.
  totalSft  Decimal? @map("total_sft") @db.Decimal(10, 2)
  // Set the moment an admin sends the client progress report (see
  // app/actions/reports.ts's sendReportToClient) — null means "never sent
  // yet". Doubles as the client-facing report route's own access gate
  // (app/(client)/client/report/page.tsx redirects away if this is null)
  // and as the only real "new report available" signal surfaced to the
  // client today, since this stack has no outbound email/notification
  // system yet (see that action's own comment for the full explanation).
  reportSentAt DateTime? @map("report_sent_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  works     Work[]
  inventoryItems InventoryItem[]
  attendanceRecords AttendanceRecord[]
  clientProfiles UserProfile[]
  draftSequences DraftSequence[]
  dailyProgressReports DailyProgressReport[]

  @@map("projects")
}

model DraftSequence {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String          @map("project_id") @db.Uuid
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy String          @map("created_by") @db.Uuid
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  nodes     DraftTaskNode[]
  edges     DraftTaskEdge[]

  @@map("draft_sequences")
}

model DraftTaskNode {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  draftSequenceId     String        @map("draft_sequence_id") @db.Uuid
  draftSequence       DraftSequence @relation(fields: [draftSequenceId], references: [id], onDelete: Cascade)
  label               String
  notes               String?       @db.Text
  plannedDurationDays Int?          @map("planned_duration_days")
  positionX           Float         @map("position_x")
  positionY           Float         @map("position_y")
  createdAt           DateTime      @default(now()) @map("created_at")

  edgesAsSource DraftTaskEdge[] @relation("DraftEdgeSource")
  edgesAsTarget DraftTaskEdge[] @relation("DraftEdgeTarget")

  @@map("draft_task_nodes")
}

model DraftTaskEdge {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  draftSequenceId String        @map("draft_sequence_id") @db.Uuid
  draftSequence   DraftSequence @relation(fields: [draftSequenceId], references: [id], onDelete: Cascade)
  sourceNodeId    String        @map("source_node_id") @db.Uuid
  targetNodeId    String        @map("target_node_id") @db.Uuid
  sourceNode      DraftTaskNode @relation("DraftEdgeSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode      DraftTaskNode @relation("DraftEdgeTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@map("draft_task_edges")
  @@unique([sourceNodeId, targetNodeId])
}

model Work {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String     @db.VarChar(100)
  code        String     @unique @db.VarChar(10)
  description String?
  color       String     @default("#6366F1") @db.VarChar(20)
  projectId   String?    @map("project_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  project     Project?   @relation(fields: [projectId], references: [id])
  tasks       HvacTask[]

  @@map("works")
}

model HvacTask {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId      String     @unique @map("task_id") @db.VarChar(20)
  taskName    String     @map("task_name")
  projectName String     @map("project_name")
  description String?
  status      TaskStatus @default(draft)
  assignedTo  String?    @map("assigned_to") @db.Uuid
  createdBy   String?    @map("created_by") @db.Uuid
  plannedStartDate DateTime? @map("planned_start_date") @db.Date
  dueDate     DateTime?  @map("due_date") @db.Date
  actualStartDate DateTime? @map("actual_start_date") @db.Date
  actualEndDate   DateTime? @map("actual_end_date") @db.Date
  workId      String?    @map("work_id") @db.Uuid
  taskTypeId  String?    @map("task_type_id") @db.Uuid
  totalSft    Decimal?   @map("total_sft") @db.Decimal(10, 2)
  // Manual override for the flowchart canvas — when set, the flowchart
  // renders the node here instead of at its dagre-computed position. Null
  // means "still auto-laid-out", not "positioned at 0,0".
  manualPositionX Float? @map("manual_position_x")
  manualPositionY Float? @map("manual_position_y")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  // Soft-delete, scoped only to the bulk "Delete All Tasks" flow (see
  // app/actions/bulk-delete.ts) — every other delete action in this app is
  // still a real, immediate delete. Non-null means "removed by a bulk
  // delete-all and pending either restore or permanent purge"; every query
  // that lists tasks for the live app must filter deletedAt: null. Dependent
  // rows (DependencyItem, TaskDependency, SftProgressEntry,
  // DependencyCompletion) are NOT soft-deleted themselves — they stay in
  // place and are excluded from view solely by their parent task already
  // being filtered out, which is simpler than threading deletedAt through
  // every related table.
  deletedAt   DateTime?  @map("deleted_at")

  work               Work?               @relation(fields: [workId], references: [id])
  taskType           TaskType?           @relation(fields: [taskTypeId], references: [id])
  dependencyItems    DependencyItem[]
  activityLogs       ActivityLog[]
  sftProgressEntries SftProgressEntry[]
  blockedByDeps      TaskDependency[]    @relation("TaskBlockedBy")
  blocksDeps         TaskDependency[]    @relation("TaskBlocks")
  parallelLinksA     TaskParallelLink[]  @relation("ParallelLinkA")
  parallelLinksB     TaskParallelLink[]  @relation("ParallelLinkB")
  dailyProgressReports DailyProgressReport[]

  @@map("hvac_tasks")
  @@index([workId])
  @@index([status])
  @@index([taskTypeId])
  @@index([deletedAt])
}

// Independent of trade/Work — any task can carry any type. Used only to
// auto-suggest a due date at creation time (defaultDurationDays working days
// from the planned start date); it has no other effect on scheduling.
model TaskType {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String     @unique
  defaultDurationDays Int        @map("default_duration_days")
  createdAt           DateTime   @default(now()) @map("created_at")

  tasks               HvacTask[]

  @@map("task_types")
}

// Cross-trade task-to-task dependency, independent of the checklist system
// above. taskId = the task that is waiting; dependsOnTaskId = the prerequisite
// that must reach `completed` first. Enforced at the application layer (see
// updateTaskStatus), not by a DB trigger — kept decoupled from the existing
// checklist-status trigger in supabase/schema.sql.
model TaskDependency {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId          String         @map("task_id") @db.Uuid
  dependsOnTaskId String         @map("depends_on_task_id") @db.Uuid
  type            DependencyType @default(FS)
  createdAt       DateTime       @default(now()) @map("created_at")

  task          HvacTask @relation("TaskBlockedBy", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask HvacTask @relation("TaskBlocks", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@map("task_dependencies")
  @@unique([taskId, dependsOnTaskId])
  @@index([taskId])
  @@index([dependsOnTaskId])
}

// Symmetric, non-blocking link between two tasks that just happen to run
// alongside each other (pure visual grouping) — unlike TaskDependency, has
// zero effect on status transitions, the delay engine, or any gating logic
// anywhere. (taskAId, taskBId) is stored in whatever order the two tasks
// were clicked in; server actions check both orderings before inserting so
// the same pair can never be linked twice regardless of click order.
model TaskParallelLink {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskAId   String   @map("task_a_id") @db.Uuid
  taskA     HvacTask @relation("ParallelLinkA", fields: [taskAId], references: [id], onDelete: Cascade)
  taskBId   String   @map("task_b_id") @db.Uuid
  taskB     HvacTask @relation("ParallelLinkB", fields: [taskBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("task_parallel_links")
  @@unique([taskAId, taskBId])
  @@index([taskAId])
  @@index([taskBId])
}

model DependencyItem {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId      String             @map("task_id") @db.Uuid
  category    DependencyCategory
  itemLabel   String             @map("item_label")
  isMandatory Boolean            @default(true) @map("is_mandatory")
  sortOrder   Int                @default(0) @map("sort_order") @db.SmallInt
  createdAt   DateTime           @default(now()) @map("created_at")

  task       HvacTask             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  completion DependencyCompletion?
  comments   Comment[]

  @@map("dependency_items")
  @@index([taskId, category])
}

model DependencyCompletion {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId      String           @unique @map("item_id") @db.Uuid
  status      CompletionStatus @default(PENDING)
  // Superseded by the Comment model (threaded, per-item, not per-completion-
  // snapshot) — kept as-is, no longer written to by updateDependencyCompletion,
  // since something else may still read it. See Comment for the real thread.
  comment     String?
  completedBy String?          @map("completed_by") @db.Uuid
  completedAt DateTime?        @map("completed_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  item DependencyItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("dependency_completions")
}

// A real threaded comment on a checklist item — belongs to the ITEM
// (persists across status changes), not to one DependencyCompletion
// snapshot. parentCommentId null = top-level; set = a reply to that comment.
// Only one level of nesting is rendered by the UI today (replies don't show
// their own "reply" affordance), but the self-relation itself supports
// deeper threads if that changes later.
model Comment {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dependencyItemId String   @map("dependency_item_id") @db.Uuid
  authorId         String?  @map("author_id") @db.Uuid
  body             String   @db.Text
  parentCommentId  String?  @map("parent_comment_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  item    DependencyItem @relation(fields: [dependencyItemId], references: [id], onDelete: Cascade)
  author  UserProfile?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent  Comment?       @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies Comment[]      @relation("CommentReplies")

  @@map("comments")
  @@index([dependencyItemId])
  @@index([parentCommentId])
}

model ActivityLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId     String?  @map("task_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  actionType String   @map("action_type") @db.VarChar(50)
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  task HvacTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@map("activity_log")
  @@index([taskId])
  @@index([createdAt])
}

model DependencyTemplateItem {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category  DependencyCategory
  label     String
  sortOrder Int                @default(0) @map("sort_order") @db.SmallInt
  updatedAt DateTime           @updatedAt @map("updated_at")

  @@map("dependency_template_items")
}

enum HolidayType {
  national_holiday
  festival_holiday
  regional_holiday
  company_shutdown
}

model Holiday {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date        DateTime    @unique @db.Date
  name        String      @db.VarChar(200)
  type        HolidayType @default(national_holiday)
  description String?
  createdAt   DateTime    @default(now()) @map("created_at")

  @@map("holidays")
}

// Incremental ledger of SFT (square footage) progress logged against a task.
// Cumulative completed SFT for a task = SUM(sftCompleted) over its entries —
// each row is an addition, never a replace-in-place value.
model SftProgressEntry {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId       String    @map("task_id") @db.Uuid
  entryDate    DateTime  @map("entry_date") @db.Date
  sftCompleted Decimal   @map("sft_completed") @db.Decimal(10, 2)
  headcount    Int?
  notes        String?   @db.Text
  recordedBy   String?   @map("recorded_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  task HvacTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, entryDate])
  @@map("sft_progress_entries")
}

model InventoryItem {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  sku            String?       @unique
  category       String?
  unit           InventoryUnit @default(PCS)
  quantityOnHand Decimal       @default(0) @map("quantity_on_hand") @db.Decimal(12, 2)
  reorderLevel   Decimal?      @map("reorder_level") @db.Decimal(12, 2)
  unitCost       Decimal?      @map("unit_cost") @db.Decimal(12, 2)
  supplier       String?
  projectId      String?       @map("project_id") @db.Uuid
  notes          String?       @db.Text
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  project      Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  transactions InventoryTransaction[]

  @@map("inventory_items")
}

// sourceDocPath stores a Supabase Storage object path (not a browsable URL) —
// the bucket is private, so a fresh signed URL is generated at render time
// wherever this needs to be shown, rather than persisting a URL that expires.
model InventoryTransaction {
  id           String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId       String                   @map("item_id") @db.Uuid
  type         InventoryTransactionType
  quantity     Decimal                  @db.Decimal(12, 2)
  sourceDocPath String?                 @map("source_doc_path")
  note         String?                  @db.Text
  recordedBy   String?                  @map("recorded_by") @db.Uuid
  createdAt    DateTime                 @default(now()) @map("created_at")

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("inventory_transactions")
}

enum AttendanceType {
  CHECK_IN
  CHECK_OUT
}

// Written by the mobile app via the Supabase client, not by this repo's own
// server actions — this repo only owns the shape of the table. userId stays
// a loose uuid (no FK), consistent with assignedTo/createdBy elsewhere in
// this schema; resolve the name via a separate UserProfile lookup at read
// time, same pattern used everywhere else.
model AttendanceRecord {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String         @map("user_id") @db.Uuid
  projectId              String?        @map("project_id") @db.Uuid
  project                Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  type                   AttendanceType
  latitude               Decimal        @db.Decimal(10, 7)
  longitude              Decimal        @db.Decimal(10, 7)
  accuracyMeters         Decimal?       @map("accuracy_meters") @db.Decimal(6, 1)
  distanceFromSiteMeters Decimal?       @map("distance_from_site_meters") @db.Decimal(8, 1)
  isFlagged              Boolean        @default(false) @map("is_flagged")
  flagReason             String?        @map("flag_reason")
  mockLocationSuspected  Boolean?       @map("mock_location_suspected")
  clientCapturedAt       DateTime       @map("client_captured_at")
  serverReceivedAt       DateTime       @default(now()) @map("server_received_at")
  reviewedAt             DateTime?      @map("reviewed_at")
  reviewedBy             String?        @map("reviewed_by") @db.Uuid

  @@map("attendance_records")
  @@index([userId, clientCapturedAt])
  @@index([projectId])
}

enum WeatherCondition {
  SUNNY
  CLOUDY
  RAINY
  WINDY
  OTHER
}

// Written by the mobile app via the Supabase client, not by this repo's own
// server actions — same pattern as AttendanceRecord above (this repo only
// owns the shape of the table). userId stays a loose uuid, resolved via a
// separate UserProfile lookup at read time, same as elsewhere in this schema.
//
// Real named fields (previously fieldOne–fieldFour placeholders) — only
// workType/workDescription are required, everything else is optional so a
// site engineer filling this out in a hurry isn't blocked by every field.
//
// KNOWN RISK — this is now the THIRD table with the same unresolved
// dependency as AttendanceRecord/UserProfile: none of this works unless a
// Supabase RLS policy exists permitting an authenticated site-engineer to
// insert their own rows (and, for photos, into
// DailyProgressReportPhoto/sft_progress_entries too — see below). That
// policy's live status is still unverified from either repo's source; this
// schema change does not resolve it, and adds two more tables to the same
// open question.
model DailyProgressReport {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  projectId String?   @map("project_id") @db.Uuid
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId    String?   @map("task_id") @db.Uuid
  task      HvacTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  workType           String            @map("work_type")
  workDescription    String            @map("work_description") @db.Text
  sftCompleted       Decimal?          @map("sft_completed") @db.Decimal(10, 2)
  workforceCount     Int?              @map("workforce_count")
  weatherCondition   WeatherCondition? @map("weather_condition")
  materialsUsed      String?           @map("materials_used") @db.Text
  equipmentUsed      String?           @map("equipment_used") @db.Text
  siteIssues         String?           @map("site_issues") @db.Text
  safetyObservations String?           @map("safety_observations") @db.Text
  visitorsOnSite     String?           @map("visitors_on_site") @db.Text
  remarks            String?           @db.Text

  reportDate       DateTime @map("report_date") @db.Date
  clientCapturedAt DateTime @map("client_captured_at")
  serverReceivedAt DateTime @default(now()) @map("server_received_at")

  photos DailyProgressReportPhoto[]

  @@map("daily_progress_reports")
  @@index([userId, reportDate])
  @@index([projectId])
}

// Uploaded during sync, not at photo-capture time — the mobile app queues
// only each photo's local device URI (small, queue-friendly) and uploads
// the actual bytes to Supabase Storage as a separate sync step, inserting
// this row once that upload succeeds. storagePath is a private-bucket
// object path (not a browsable URL), same convention as
// InventoryTransaction.sourceDocPath — signed URLs are generated fresh at
// render time, never persisted.
model DailyProgressReportPhoto {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId    String              @map("report_id") @db.Uuid
  report      DailyProgressReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  storagePath String              @map("storage_path")
  caption     String?
  createdAt   DateTime            @default(now()) @map("created_at")

  @@map("daily_progress_report_photos")
  @@index([reportId])
}
